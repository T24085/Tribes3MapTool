{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES map intake manifest, version 42",
  "description": "Private Ascend draft with one or more convex collision shapes in its mesh geometry. Materials and placement overrides are optional.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "profile", "source_game", "name", "reader", "profile_sha256", "sources", "files", "coverage", "minimap", "interiors", "interior_review"],
  "properties": {
    "format": {"const": 42},
    "profile": {"$ref": "intake-v41.schema.json#/properties/profile"},
    "source_game": {"$ref": "intake-v41.schema.json#/properties/source_game"},
    "name": {"$ref": "intake-v41.schema.json#/properties/name"},
    "reader": {"$ref": "intake-v41.schema.json#/properties/reader"},
    "profile_sha256": {"$ref": "intake-v41.schema.json#/properties/profile_sha256"},
    "sources": {"$ref": "intake-v41.schema.json#/properties/sources"},
    "coverage": {"$ref": "intake-v41.schema.json#/properties/coverage"},
    "minimap": {"$ref": "intake-v41.schema.json#/properties/minimap"},
    "environment": {"$ref": "intake-v41.schema.json#/properties/environment"},
    "interiors": {"$ref": "intake-v41.schema.json#/properties/interiors"},
    "interior_review": {"$ref": "intake-v41.schema.json#/properties/interior_review"},
    "files": {"$ref": "intake-v41.schema.json#/properties/files"}
  }
}
