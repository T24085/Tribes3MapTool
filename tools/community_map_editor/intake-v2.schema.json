{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES map intake manifest, version 2",
  "type": "object",
  "required": ["format", "profile", "reader", "name", "source_game", "profile_sha256", "sources", "files", "coverage"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -10000000, "maximum": 10000000}},
    "zoom": {"type": "number", "minimum": 0.05, "maximum": 32}
  },
  "properties": {
    "format": {"const": 2},
    "profile": {"const": "tribes2-ctf"},
    "reader": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source_game": {"type": "string", "minLength": 1},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "origin", "sha256"],
      "properties": {"name": {"type": "string"}, "origin": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}
    }},
    "files": {
      "type": "object", "required": ["objects.json", "terrain.json", "height.png"], "maxProperties": 14,
      "propertyNames": {"pattern": "^(objects\\.json|terrain\\.json|height\\.png|material-(index|[0-7])\\.png|minimap\\.png)$"},
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "coverage": {"type": "object", "propertyNames": {"enum": ["group", "marker", "terrain", "excluded", "review", "boundary"]},
      "additionalProperties": {"type": "integer", "minimum": 0}},
    "minimap": {
      "type": "object", "additionalProperties": false,
      "required": ["center", "extent", "scale", "rotation_deg", "zoom", "image", "image_bounds"],
      "properties": {
        "center": {"$ref": "#/$defs/point"},
        "extent": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 100, "maximum": 10000000}},
        "scale": {"type": "number", "minimum": 0.1, "maximum": 10},
        "rotation_deg": {"type": "number", "minimum": -360, "maximum": 360},
        "zoom": {
          "type": "object", "additionalProperties": false, "required": ["min", "default", "max"],
          "properties": {"min": {"$ref": "#/$defs/zoom"}, "default": {"$ref": "#/$defs/zoom"}, "max": {"$ref": "#/$defs/zoom"}}
        },
        "image": {"const": "minimap.png"},
        "image_bounds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}}
      }
    }
  },
  "if": {"required": ["minimap"]},
  "then": {"properties": {"files": {"required": ["minimap.png"]}, "coverage": {
    "required": ["boundary"], "properties": {"boundary": {"const": 1}}
  }}},
  "else": {"properties": {"files": {"not": {"required": ["minimap.png"]}}, "coverage": {
    "properties": {"boundary": {"const": 0}}
  }}}
}
