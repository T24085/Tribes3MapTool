{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES map intake manifest, version 26",
  "description": "Vengeance compiled world geometry with private surface material and source texture bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "profile", "source_game", "name", "reader", "profile_sha256", "sources", "files", "coverage", "minimap", "interiors", "interior_review"],
  "properties": {
    "format": {"const": 26},
    "profile": {"$ref": "intake-v25.schema.json#/properties/profile"},
    "source_game": {"$ref": "intake-v25.schema.json#/properties/source_game"},
    "name": {"$ref": "intake-v25.schema.json#/properties/name"},
    "reader": {"$ref": "intake-v25.schema.json#/properties/reader"},
    "profile_sha256": {"$ref": "intake-v25.schema.json#/properties/profile_sha256"},
    "sources": {"$ref": "intake-v25.schema.json#/properties/sources"},
    "coverage": {"$ref": "intake-v25.schema.json#/properties/coverage"},
    "minimap": {"$ref": "intake-v25.schema.json#/properties/minimap"},
    "environment": {"$ref": "intake-v25.schema.json#/properties/environment"},
    "interiors": {"$ref": "intake-v25.schema.json#/properties/interiors"},
    "interior_review": {"$ref": "intake-v25.schema.json#/properties/interior_review"},
    "terrain_paint": {"$ref": "intake-v25.schema.json#/properties/terrain_paint"},
    "terrain_art": {"$ref": "intake-v25.schema.json#/properties/terrain_art"},
    "terrain_uv": {"$ref": "intake-v25.schema.json#/properties/terrain_uv"},
    "files": {
      "type": "object",
      "required": ["objects.json", "terrain.json", "height.png", "minimap.png", "source-scene.json", "model-textures.json"],
      "propertyNames": {"anyOf": [
        {"enum": ["objects.json", "terrain.json", "height.png", "minimap.png", "source-scene.json", "model-textures.json"]},
        {"pattern": "^interior-[0-9]{4}\\.json$"},
        {"pattern": "^terrain-alpha-(?:0[0-9]|[12][0-9]|3[01])\\.png$"},
        {"pattern": "^terrain-art-[a-f0-9]{32}\\.png$"},
        {"pattern": "^texture_[a-f0-9]{32}\\.png$"}
      ]},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  },
  "dependentRequired": {
    "terrain_art": ["terrain_paint", "terrain_uv"],
    "terrain_uv": ["terrain_art"]
  }
}
