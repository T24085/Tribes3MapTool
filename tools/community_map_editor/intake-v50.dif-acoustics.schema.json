{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tribes 2 private DIF acoustic geometry with original collision fan data",
  "type": "object",
  "required": ["nodes", "outside_surfaces", "portal_centers_m", "surface_runs", "collision"],
  "additionalProperties": false,
  "properties": {
    "nodes": {"$ref": "intake-v49.dif-acoustics.schema.json#/properties/nodes"},
    "outside_surfaces": {"$ref": "intake-v49.dif-acoustics.schema.json#/properties/outside_surfaces"},
    "portal_centers_m": {"$ref": "intake-v49.dif-acoustics.schema.json#/properties/portal_centers_m"},
    "surface_runs": {"$ref": "intake-v49.dif-acoustics.schema.json#/properties/surface_runs"},
    "collision": {
      "type": "object",
      "required": ["node_planes", "solid_children", "leaves", "faces"],
      "additionalProperties": false,
      "properties": {
        "node_planes": {
          "type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/plane"}
        },
        "solid_children": {
          "type": "array", "minItems": 1, "maxItems": 32768,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "integer", "minimum": -1, "maximum": 16383}
          }
        },
        "leaves": {
          "type": "array", "minItems": 1, "maxItems": 16384,
          "items": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 65535}}
        },
        "faces": {
          "type": "array", "minItems": 1, "maxItems": 65536,
          "items": {
            "type": "array", "minItems": 1, "maxItems": 33,
            "prefixItems": [{"$ref": "#/$defs/plane"}], "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {"plane": {"type": "integer", "minimum": 0, "maximum": 65535}}
}
