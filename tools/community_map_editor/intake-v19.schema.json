{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES map intake manifest, version 19",
  "description": "Tribes 1 maps with at least one DTS prop that has authored collision geometry.",
  "type": "object",
  "required": ["format", "profile", "reader", "name", "source_game", "profile_sha256", "sources", "files", "coverage", "shapes", "shape_review"],
  "properties": {
    "format": {"const": 19},
    "profile": {"$ref": "intake-v18.schema.json#/properties/profile"},
    "source_game": {"$ref": "intake-v18.schema.json#/properties/source_game"},
    "reader": {"$ref": "intake-v18.schema.json#/properties/reader"},
    "name": {"$ref": "intake-v18.schema.json#/properties/name"},
    "profile_sha256": {"$ref": "intake-v18.schema.json#/properties/profile_sha256"},
    "sources": {"$ref": "intake-v18.schema.json#/properties/sources"},
    "coverage": {"$ref": "intake-v18.schema.json#/properties/coverage"},
    "minimap": {"$ref": "intake-v18.schema.json#/properties/minimap"},
    "environment": {"$ref": "intake-v18.schema.json#/properties/environment"},
    "terrain_art": {"$ref": "intake-v18.schema.json#/properties/terrain_art"},
    "files": {"$ref": "intake-v18.schema.json#/properties/files", "required": ["model-textures.json"]},
    "interiors": {"$ref": "intake-v18.schema.json#/properties/interiors"},
    "interior_review": {"$ref": "intake-v18.schema.json#/properties/interior_review"},
    "shapes": {"$ref": "intake-v18.schema.json#/properties/shapes", "minProperties": 1},
    "shape_review": {"$ref": "intake-v18.schema.json#/properties/shape_review"}
  },
  "dependentRequired": {
    "interiors": ["interior_review"],
    "interior_review": ["interiors"]
  },
  "if": {"required": ["minimap"]},
  "then": {"$ref": "intake-v18.schema.json#/then"},
  "else": {"$ref": "intake-v18.schema.json#/else"}
}
