{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES 2 map intake with private inherited mission audio, version 48",
  "type": "object",
  "required": ["format", "profile", "reader", "name", "source_game", "profile_sha256", "sources", "files", "coverage"],
  "properties": {
    "format": {"const": 48},
    "profile": {"$ref": "intake-v47.schema.json#/properties/profile"},
    "reader": {"const": "t2-mission-v48.0"},
    "name": {"$ref": "intake-v47.schema.json#/properties/name"},
    "source_game": {"const": "Tribes 2"},
    "profile_sha256": {"$ref": "intake-v47.schema.json#/properties/profile_sha256"},
    "sources": {"$ref": "intake-v47.schema.json#/properties/sources"},
    "coverage": {"$ref": "intake-v47.schema.json#/properties/coverage"},
    "minimap": {"$ref": "intake-v47.schema.json#/properties/minimap"},
    "environment": {"$ref": "intake-v47.schema.json#/properties/environment"},
    "interiors": {"$ref": "intake-v47.schema.json#/properties/interiors"},
    "interior_review": {"$ref": "intake-v47.schema.json#/properties/interior_review"},
    "shapes": {"$ref": "intake-v47.schema.json#/properties/shapes"},
    "shape_review": {"$ref": "intake-v47.schema.json#/properties/shape_review"},
    "files": {"$ref": "intake-v47.schema.json#/properties/files"}
  },
  "if": {"required": ["minimap"]},
  "then": {"$ref": "intake-v47.schema.json#/then"},
  "else": {"$ref": "intake-v47.schema.json#/else"},
  "dependentRequired": {
    "interiors": ["interior_review"],
    "interior_review": ["interiors"],
    "shapes": ["shape_review"],
    "shape_review": ["shapes"]
  }
}
