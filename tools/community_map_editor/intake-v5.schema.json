{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES map intake manifest, version 5",
  "type": "object",
  "required": [
    "format",
    "profile",
    "reader",
    "name",
    "source_game",
    "profile_sha256",
    "sources",
    "files",
    "coverage",
    "shapes",
    "shape_review"
  ],
  "$defs": {
    "reference": {
      "pattern": "^interiorinstance:.+$"
    },
    "geometry": {
      "type": "string",
      "pattern": "^interior-[0-9]{4}\\.json$"
    }
  },
  "properties": {
    "format": {
      "const": 5
    },
    "profile": {
      "$ref": "intake-v2.schema.json#/properties/profile"
    },
    "reader": {
      "$ref": "intake-v2.schema.json#/properties/reader"
    },
    "name": {
      "$ref": "intake-v2.schema.json#/properties/name"
    },
    "source_game": {
      "$ref": "intake-v2.schema.json#/properties/source_game"
    },
    "profile_sha256": {
      "$ref": "intake-v2.schema.json#/properties/profile_sha256"
    },
    "sources": {
      "$ref": "intake-v2.schema.json#/properties/sources"
    },
    "coverage": {
      "$ref": "intake-v2.schema.json#/properties/coverage"
    },
    "minimap": {
      "$ref": "intake-v2.schema.json#/properties/minimap"
    },
    "environment": {
      "$ref": "intake-v3.schema.json#/properties/environment"
    },
    "files": {
      "type": "object",
      "required": [
        "objects.json",
        "terrain.json",
        "height.png"
      ],
      "maxProperties": 143,
      "propertyNames": {
        "pattern": "^(objects\\.json|terrain\\.json|height\\.png|material-(index|[0-7])\\.png|minimap\\.png|(interior|shape)-[0-9]{4}\\.json)$"
      },
      "additionalProperties": {
        "$ref": "intake-v2.schema.json#/$defs/digest"
      }
    },
    "interiors": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/reference"
      },
      "additionalProperties": {
        "$ref": "#/$defs/geometry"
      }
    },
    "interior_review": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/reference"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "shapes": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^(tsstatic|staticshape):.+\\.dts$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^shape-[0-9]{4}\\.json$"
      }
    },
    "shape_review": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^(tsstatic|staticshape):.+\\.dts$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "shapes": {
          "minProperties": 1
        }
      }
    },
    {
      "properties": {
        "shape_review": {
          "minProperties": 1
        }
      }
    }
  ],
  "if": {
    "required": [
      "minimap"
    ]
  },
  "then": {
    "$ref": "intake-v2.schema.json#/then"
  },
  "else": {
    "$ref": "intake-v2.schema.json#/else"
  },
  "dependentRequired": {
    "interiors": [
      "interior_review"
    ],
    "interior_review": [
      "interiors"
    ]
  }
}
