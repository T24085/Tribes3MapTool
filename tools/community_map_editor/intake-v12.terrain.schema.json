{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES tiled terrain, intake version 12",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin_cm", "step_cm", "cm_per_m", "y_sign", "material_layers", "tile_grid", "terrain_blocks"],
  "properties": {
    "origin_cm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -2000000, "maximum": 2000000}},
    "step_cm": {"type": "number", "exclusiveMinimum": 0, "maximum": 20000},
    "cm_per_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
    "y_sign": {"enum": [-1, 1]},
    "material_layers": {"const": []},
    "tile_grid": {
      "description": "Rectangular rows of zero-based indices into terrain_blocks. All blocks must be referenced. Neighboring tiles share edge samples, owned by the tile with the larger grid index.",
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 4095}}
    },
    "terrain_blocks": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["height_m", "holes"],
        "properties": {
          "height_m": {"type": "array", "minItems": 66049, "maxItems": 66049, "items": {"type": "number", "minimum": -2048, "maximum": 2048}},
          "holes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
          "legacy_grid": {"$ref": "#/$defs/legacy_grid"}
        }
      }
    }
  },
  "$defs": {
    "legacy_grid": {
      "type": "object", "additionalProperties": false,
      "required": ["block_version", "tile", "grid_size", "block_id", "material_list", "height_range_m", "material_flags", "material_indices"],
      "properties": {
        "block_version": {"enum": [0, 4, 5]},
        "tile": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 63}},
        "grid_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 64}},
        "block_id": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "material_list": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "height_range_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -2048, "maximum": 2048}},
        "material_flags": {"type": "string", "pattern": "^[0-9a-f]{131072}$"},
        "material_indices": {"type": "string", "pattern": "^[0-9a-f]{131072}$"}
      }
    }
  }
}
