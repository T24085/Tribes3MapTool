{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES 2 map intake with private DIF acoustic geometry, version 49",
  "type": "object",
  "required": [
    "format",
    "profile",
    "reader",
    "name",
    "source_game",
    "profile_sha256",
    "sources",
    "files",
    "coverage",
    "interiors",
    "interior_review"
  ],
  "properties": {
    "format": {
      "const": 49
    },
    "profile": {
      "$ref": "intake-v48.schema.json#/properties/profile"
    },
    "reader": {
      "const": "t2-mission-v49.0"
    },
    "name": {
      "$ref": "intake-v48.schema.json#/properties/name"
    },
    "source_game": {
      "$ref": "intake-v48.schema.json#/properties/source_game"
    },
    "profile_sha256": {
      "$ref": "intake-v48.schema.json#/properties/profile_sha256"
    },
    "sources": {
      "$ref": "intake-v48.schema.json#/properties/sources"
    },
    "coverage": {
      "$ref": "intake-v48.schema.json#/properties/coverage"
    },
    "minimap": {
      "$ref": "intake-v48.schema.json#/properties/minimap"
    },
    "environment": {
      "$ref": "intake-v48.schema.json#/properties/environment"
    },
    "interiors": {
      "$ref": "intake-v48.schema.json#/properties/interiors"
    },
    "interior_review": {
      "$ref": "intake-v48.schema.json#/properties/interior_review"
    },
    "shapes": {
      "$ref": "intake-v48.schema.json#/properties/shapes"
    },
    "shape_review": {
      "$ref": "intake-v48.schema.json#/properties/shape_review"
    },
    "files": {
      "$ref": "intake-v48.schema.json#/properties/files"
    }
  },
  "if": {
    "required": [
      "minimap"
    ]
  },
  "then": {
    "$ref": "intake-v48.schema.json#/then"
  },
  "else": {
    "$ref": "intake-v48.schema.json#/else"
  },
  "dependentRequired": {
    "shapes": [
      "shape_review"
    ],
    "shape_review": [
      "shapes"
    ]
  }
}
