{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tribes 1 default-pose DTS geometry",
  "type": "object",
  "required": ["format", "source", "materials", "vertices_m", "triangles"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 4},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "decoder_sha256", "dts_version", "lod", "sequences", "max_visible_frames"],
      "properties": {
        "name": {"type": "string", "pattern": "^[^:/\\\\]{1,240}[.][dD][tT][sS]$"},
        "sha256": {"$ref": "intake-v2.schema.json#/$defs/digest"},
        "decoder_sha256": {"$ref": "intake-v2.schema.json#/$defs/digest"},
        "dts_version": {"type": "integer", "minimum": 5, "maximum": 8},
        "lod": {"type": "integer", "minimum": 0, "maximum": 1023},
        "sequences": {"type": "integer", "minimum": 0, "maximum": 250000},
        "max_visible_frames": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "materials": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "vertices_m": {
      "type": "array", "minItems": 3, "maxItems": 150000,
      "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -20000, "maximum": 20000}}
    },
    "triangles": {
      "type": "array", "minItems": 1, "maxItems": 250000,
      "items": {"type": "array", "minItems": 10, "maxItems": 10,
        "prefixItems": [
          {"type": "integer", "minimum": 0, "maximum": 255},
          {"$ref": "#/$defs/vertex"},
          {"$ref": "#/$defs/vertex"},
          {"$ref": "#/$defs/vertex"}
        ],
        "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}
      }
    }
  },
  "$defs": {"vertex": {"type": "integer", "minimum": 0, "maximum": 149999}}
}
