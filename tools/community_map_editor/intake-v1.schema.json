{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIBES map intake manifest, version 1",
  "type": "object",
  "required": ["format","profile","reader","name","source_game","profile_sha256","sources","files","coverage"],
  "$defs": {"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
  "properties": {
    "format":{"const":1}, "profile":{"const":"tribes2-ctf"},
    "reader":{"type":"string","minLength":1}, "name":{"type":"string","minLength":1},
    "source_game":{"type":"string","minLength":1}, "profile_sha256":{"$ref":"#/$defs/digest"},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["name","origin","sha256"],
      "properties":{"name":{"type":"string"},"origin":{"type":"string"},"sha256":{"$ref":"#/$defs/digest"}}}},
    "files":{"type":"object","required":["objects.json","terrain.json","height.png"],"maxProperties":13,
      "propertyNames":{"pattern":"^(objects\\.json|terrain\\.json|height\\.png|material-(index|[0-7])\\.png)$"},
      "additionalProperties":{"$ref":"#/$defs/digest"}},
    "coverage":{"type":"object","propertyNames":{"enum":["group","marker","terrain","excluded","review"]},
      "additionalProperties":{"type":"integer","minimum":0}}
  }
}
